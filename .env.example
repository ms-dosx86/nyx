# Скопируйте содержимое в .env и заполните обязательные поля.
# Домен без протокола, порта и пути.
DOMAIN=example.com
PG_USER=nyx

# Для каждого пароля/ключа ниже задайте отдельное случайное значение:
# не менее 32 латинских букв и цифр. Пустые значения блокируют запуск.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
PG_PASS=
REDIS_PASS=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CDN_SECRET=
S3_SECRET_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
METRICS_TOKEN=
